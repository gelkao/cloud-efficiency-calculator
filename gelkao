#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$here/lib.sh"

usage() {
  cat <<'EOF'
Usage:
  cat data/*.html | gelkao [-g "<project>"] [-d <dir>] [-f <path>]   fetch invoices and audit
  cat data/*.html | gelkao list                                     list the customer number and invoice UUIDs
  gelkao [-d <dir>] fetch                                           download invoice CSVs (output of list on stdin)
  gelkao [-g "<project>"] [-d <dir>] [-f <path>] audit              build the DB from CSVs and audit

  -g "<project>"   audit only one Hetzner project (the invoice "grouping" column);
                   valid for the full run and audit only
  -d <dir>         CSV directory (default: data)
  -f <path>        database file (default: <dir>/gelkao.db)
  -q               skip the price-refresh prompt (non-interactive)

The customer number is read from the invoice page itself — there is nothing to type.
EOF
}

banner() {
  local b='' u='' r=''
  if [ -t 2 ]; then b=$'\e[1m'; u=$'\e[34m'; r=$'\e[0m'; fi
  printf '\n%sCloud Inefficiency Audit%s · %shttps://gelkao.com%s\n\n' "$b" "$r" "$u" "$r" >&2
}

cmd_list() { list_invoices "$@"; }

cmd_fetch() { fetch_all "$1"; }

cmd_audit() {
  local grouping=$1 quiet=$2 data_dir=$3 db=$4
  audit "$here" "$data_dir" "$db" "$grouping" "$quiet"
}

cmd_run() {
  local grouping=$1 quiet=$2 data_dir=$3 db=$4
  banner
  run_pipeline "$here" "$data_dir" "$db" "$grouping" "$quiet"
}

main() {
  local OPTIND grouping="" quiet=0 data_dir=data data_dir_set=0 db=""
  [[ "${1-}" = "--help" ]] && { usage; exit 0; }
  while getopts ":g:d:f:hq" opt; do
    case "$opt" in
      g) grouping=$OPTARG ;;
      d) data_dir=$OPTARG; data_dir_set=1 ;;
      f) db=$OPTARG ;;
      q) quiet=1 ;;
      h) usage; exit 0 ;;
      :) die "option -$OPTARG requires a value" ;;
      \?) die "unknown option: -$OPTARG" ;;
    esac
  done
  shift $((OPTIND - 1))
  case "${1-}" in
    '')    if [ -t 0 ]; then usage; exit 2; fi
           cmd_run "$grouping" "$quiet" "$data_dir" "$db" ;;
    list)  shift; [[ -z "$grouping" ]] || die "-g is not valid for list"; [[ "$data_dir_set" = 0 ]] || die "-d is not valid for list"; [[ -z "$db" ]] || die "-f is not valid for list"; cmd_list "$@" ;;
    fetch) shift; [[ -z "$grouping" ]] || die "-g is not valid for fetch"; [[ -z "$db" ]] || die "-f is not valid for fetch"; cmd_fetch "$data_dir" ;;
    audit) shift; cmd_audit "$grouping" "$quiet" "$data_dir" "$db" ;;
    *)     die "unknown command: $1 — try list, fetch, audit, or --help" ;;
  esac
}

main "$@"
